{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KarinCore",
  "version": "0.1.0-alpha.31",
  "identifier": "com.nikitahya.karincore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "windows": [
      {
        "title": "KarinCore",
        "width": 900,
        "height": 700,
        "minWidth": 750,
        "minHeight": 550,
        "decorations": false,
        "transparent": true,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 24,
      "versionCode": 31
    },
    "linux": {
      "deb": {
        "depends": [
          "openvpn",
          "wireguard-tools",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "python3",
          "unzip"
        ],
        "files": {
          "/etc/sudoers.d/zz-karincore": "system/karincore-sudoers",
          "/etc/systemd/system/karin-proxy-daemon.service": "system/karin-proxy-daemon.service",
          "/etc/karin-proxy/route.sh": "system/route.sh",
          "/usr/libexec/karincore-helper": "system/karincore-helper",
          "/usr/share/pixmaps/karin-proxy.png": "icons/icon.png"
        }
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/android/mipmap-mdpi/ic_launcher.png",
      "icons/android/mipmap-hdpi/ic_launcher.png",
      "icons/android/mipmap-xhdpi/ic_launcher.png",
      "icons/android/mipmap-xxhdpi/ic_launcher.png",
      "icons/android/mipmap-xxxhdpi/ic_launcher.png"
    ]
  }
}
