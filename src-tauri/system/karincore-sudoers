# Правила sudo для привилегированного хелпера KarinCore.
#
# Ограничены группой `karincore` (создаётся и заполняется устанавливающим
# пользователем post-install хуком пакета) вместо `ALL ALL`. При старых
# правилах `ALL ALL=(ALL) NOPASSWD:` их мог вызвать ЛЮБОЙ локальный
# аккаунт в системе, а не только тот, кто реально пользуется приложением —
# это особенно критично в сочетании друг с другом (см. ниже).
#
# Два самых опасных правила, которые раньше были здесь,
#   /usr/bin/cp /tmp/xray /usr/local/bin/xray
#   /usr/bin/chmod +x /usr/local/bin/xray
# убраны полностью, а не просто ограничены группой. Xray устанавливается и
# обновляется только через системный пакетный менеджер (это depends= в
# PKGBUILD), так что у приложения нет законной причины когда-либо копировать
# выбранный атакующим файл из world-writable пути в системный bin-каталог и
# делать его исполняемым. В сочетании с правилом перезапуска сервиса ниже
# (демон работает от root и исполняет именно этот бинарник) это была
# одношаговая локальная эскалация привилегий до root для любого, кто мог
# писать в /tmp.
%karincore ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart karin-proxy-daemon.service
%karincore ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop karin-proxy-daemon.service
%karincore ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u karin-proxy-daemon.service -n 15 --no-pager
%karincore ALL=(ALL) NOPASSWD: /usr/bin/openvpn --config /etc/karin-proxy/openvpn.ovpn
%karincore ALL=(ALL) NOPASSWD: /usr/bin/pkill -f /etc/karin-proxy/openvpn.ovpn
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /etc/resolv.conf /etc/karin-proxy/resolv.conf.bak
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /etc/karin-proxy/resolv.conf.vpn /etc/resolv.conf
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /etc/karin-proxy/resolv.conf.bak /etc/resolv.conf
%karincore ALL=(ALL) NOPASSWD: /usr/bin/rm -f /etc/karin-proxy/resolv.conf.bak
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip rule del fwmark 111 lookup 111
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip route add default dev tun-ovpn table 111
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip rule add fwmark 111 lookup 111
%karincore ALL=(ALL) NOPASSWD: /usr/bin/sysctl -w net.ipv4.conf.tun-ovpn.rp_filter=0
%karincore ALL=(ALL) NOPASSWD: /usr/bin/sysctl -w net.ipv4.conf.all.rp_filter=0
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -t nat -A POSTROUTING -o tun-ovpn -j MASQUERADE
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -t nat -D POSTROUTING -o tun-ovpn -j MASQUERADE
%karincore ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /etc/karin-proxy/geo
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/geosite.dat /etc/karin-proxy/geo/geosite.dat
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/geoip.dat /etc/karin-proxy/geo/geoip.dat
%karincore ALL=(ALL) NOPASSWD: /usr/bin/wg-quick up /etc/karin-proxy/wg0.conf
%karincore ALL=(ALL) NOPASSWD: /usr/bin/wg-quick down /etc/karin-proxy/wg0.conf
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip route add default dev wg0 table 111
%karincore ALL=(ALL) NOPASSWD: /usr/bin/sysctl -w net.ipv4.conf.wg0.rp_filter=0
%karincore ALL=(ALL) NOPASSWD: /usr/bin/wg show wg0
# Сужено с прежнего голого `ip rule del *` — т.к. sudoers сопоставляет всю
# строку аргументов через fnmatch, где `*` совпадает и с пробелами тоже,
# старое правило позволяло удалить ЛЮБОЕ ip-правило в системе, а не только
# те, что создаёт само приложение. Эти два паттерна покрывают именно то,
# что реально использует код.
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip rule del to * lookup main
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip rule del to * lookup *
%karincore ALL=(ALL) NOPASSWD: /usr/bin/ip route del *
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/karin_config.json /etc/karin-proxy/config.json
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/karin_openvpn.ovpn /etc/karin-proxy/openvpn.ovpn
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/karin_wg0.conf /etc/karin-proxy/wg0.conf
%karincore ALL=(ALL) NOPASSWD: /usr/bin/cp /tmp/karin_resolv.conf.vpn /etc/karin-proxy/resolv.conf.vpn
# Kill switch (iptables OUTPUT allow/drop chain) — см. enable_kill_switch()/
# disable_kill_switch() в main.rs. `-d *` здесь неизбежен: это IP сервера,
# который выбирает сам пользователь, но ограничен группой и только
# цепочкой OUTPUT, остального не затрагивает.
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -o lo -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -o tun0 -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -o tun-ovpn -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -o wg0 -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -d * -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -A OUTPUT -j DROP
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -o lo -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -o tun0 -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -o tun-ovpn -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -o wg0 -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -d * -j ACCEPT
%karincore ALL=(ALL) NOPASSWD: /usr/bin/iptables -D OUTPUT -j DROP
%karincore ALL=(ALL) NOPASSWD: /usr/bin/rm -f /tmp/karin_killswitch_server_ip
