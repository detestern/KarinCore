# Создаёт группу `karincore`, которой /etc/sudoers.d/zz-karincore теперь
# ограничивает свои NOPASSWD-правила, и добавляет в неё устанавливающего
# пользователя. Раньше эти правила были написаны как
# `ALL ALL=(ALL) NOPASSWD:`, то есть их мог вызвать любой локальный
# аккаунт — этот хук позволяет ограничить их реальными пользователями
# приложения, не ломая при этом типичный однопользовательский
# десктоп/Steam Deck сценарий, для которого этот пакет в основном и ставится.

_add_installing_user() {
    local target_user="${SUDO_USER:-${DOAS_USER:-}}"
    if [ -z "$target_user" ]; then
        target_user="$(logname 2>/dev/null || true)"
    fi
    if [ -n "$target_user" ] && [ "$target_user" != "root" ]; then
        gpasswd -a "$target_user" karincore >/dev/null 2>&1
        echo "==> Пользователь '$target_user' добавлен в группу 'karincore'."
        echo "    Перезайдите в сессию (или выполните 'newgrp karincore'), чтобы это применилось."
    else
        echo "==> Не удалось определить, какого пользователя добавить в группу 'karincore'."
        echo "    Выполните: sudo gpasswd -a <ваш-логин> karincore"
    fi
}

# Миграция со старых версий (до 1.5.0): каталог /etc/karin-proxy принадлежал
# обычному пользователю. Теперь с ним работает только root-helper.
_fix_conf_dir_owner() {
    if [ -d /etc/karin-proxy ] && [ ! -L /etc/karin-proxy ]; then
        find /etc/karin-proxy -type l -delete 2>/dev/null || true
        chown -R root:root /etc/karin-proxy
        chmod -R go-w /etc/karin-proxy
    fi

    # Уборка остатков старых версий. Всё это были файлы времён, когда каталог принадлежал
    # пользователю: конфигурации с ключами/паролями (config.json мог лежать с правами 0644),
    # служебные копии и логи, которые теперь живут в /var/log/karin-proxy.
    rm -f /etc/karin-proxy/resolv.conf.vpn /etc/karin-proxy/*.log 2>/dev/null || true
    chmod 0600 /etc/karin-proxy/config.json /etc/karin-proxy/openvpn.ovpn /etc/karin-proxy/wg0.conf 2>/dev/null || true
    # Конфигурации OpenVPN/WireGuard нужны только пока туннель поднят: если его нет, ключи не храним.
    if [ ! -d /sys/class/net/wg0 ] && [ ! -d /sys/class/net/tun-ovpn ]; then
        rm -f /etc/karin-proxy/openvpn.ovpn /etc/karin-proxy/wg0.conf 2>/dev/null || true
    fi
    # Журналы содержат адреса сайтов: читать их могут только root и группа karincore.
    install -d -m 0750 -o root -g karincore /var/log/karin-proxy
    chgrp karincore /var/log/karin-proxy/*.log 2>/dev/null || true
    chmod 0640 /var/log/karin-proxy/*.log 2>/dev/null || true
}

post_install() {
    getent group karincore >/dev/null 2>&1 || groupadd -r karincore
    _fix_conf_dir_owner
    _add_installing_user
}

post_upgrade() {
    getent group karincore >/dev/null 2>&1 || groupadd -r karincore
    _fix_conf_dir_owner
    # Добавляем автоматически только если в группе вообще никого нет —
    # апгрейд не должен молча менять членство в группе на уже настроенной
    # многопользовательской системе.
    if [ -z "$(getent group karincore | cut -d: -f4)" ]; then
        _add_installing_user
    fi
}

post_remove() {
    getent group karincore >/dev/null 2>&1 && groupdel karincore >/dev/null 2>&1 || true
}
