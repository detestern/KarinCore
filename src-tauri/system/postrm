#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl stop karin-proxy-daemon.service >/dev/null 2>&1 || true
        systemctl disable karin-proxy-daemon.service >/dev/null 2>&1 || true
    fi

    rm -f /etc/sudoers.d/zz-karincore

    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
    fi
fi

exit 0
