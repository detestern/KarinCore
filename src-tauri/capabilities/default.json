{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "android-main",
  "description": "Android permissions for KarinCore main webview",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "permissions": [
    "core:default",
